# 복사해서 .env로 쓰세요. .env는 커밋하지 않습니다.

# 서버·alembic이 접속할 DB. postgresql:// 로 시작해도 자동으로 postgresql+psycopg:// 로 바꿔 씁니다.
# Supabase는 Session pooler 연결 문자열을 그대로 붙여 넣습니다.
DATABASE_URL=postgresql+psycopg://localhost/kanban

# pytest 전용 DB (테스트마다 6개 테이블을 비웁니다. 운영 DB를 쓰지 마세요).
TEST_DATABASE_URL=postgresql+psycopg://localhost/kanban_test

# SQLAlchemy 연결 풀 (Supabase 무료 플랜의 세션 풀러 한도를 넘지 않게 작게 둡니다).
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# 풀에서 연결을 꺼낼 때 select 1로 생존을 확인합니다(끊긴 연결을 걸러냄).
# 풀 연결 수(pool_size+max_overflow)만큼만 동시에 세션을 받고, 초과분은 DATABASE_POOL_TIMEOUT초 대기 후 503 `database busy, try again`.
DATABASE_POOL_PRE_PING=true
